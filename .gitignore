# ==============================================================================
# WARLINK .gitignore
# ==============================================================================

# Executables and Libraries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.sys
!internal/embedded/assets/bin/*.exe
!internal/embedded/assets/bin/*.dll
!internal/embedded/assets/bin/*.sys
!internal/embedded/assets/bin/*.gz
server/warlink-server*

# Go Test and Profiling Artifacts
*.test
*.out
*.prof
*.pprof
coverage.html

# Checksums and Release Archives
*.sha256
*.zip
*.7z
*.rar
*.gz
!internal/embedded/assets/bin/*.gz

# Sensitive Credentials and Configs
config.json
*.key
*.crt
*.pem
.env
.env.*

# Network Captures, Crash Dumps and Logs
*.pcap
*.pcapng
*.cap
*.dmp
*.log

# Databases and Local Caches
*.db
*.sqlite
*.sqlite3

# WarLink Runtime and Working Directories
warlink_core/
zapret-*/
dist/
tmp/
temp/
icons/
test/
scratch/

# Local Helper Scripts and Design Notes
build.bat
cloudflare-DESIGN.md
AGENTS.md
STEAM_GUIDE.md
CHANGELOG.md
check_tunnel.ps1

# IDE and Editor Files
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~
*.code-workspace

# Operating System Metadata
desktop.ini
Thumbs.db
.DS_Store
