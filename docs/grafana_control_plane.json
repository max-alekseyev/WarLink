      "id": 101,
      "options": {
        "content": "<style>\n.wl-ctrl-root {\n  background: #111111;\n  border: 1px solid #242424;\n  border-radius: 2px;\n  padding: 18px 20px;\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  color: #ededed;\n  box-sizing: border-box;\n}\n.wl-label {\n  display: block;\n  font-size: 10px;\n  color: #888888;\n  text-transform: uppercase;\n  font-weight: 700;\n  letter-spacing: 0.5px;\n  margin-bottom: 6px;\n}\n.wl-input, .wl-select {\n  width: 100% !important;\n  height: 34px !important;\n  background-color: #141414 !important;\n  border: 1px solid #333333 !important;\n  color: #f0f0f0 !important;\n  border-radius: 2px !important;\n  padding: 6px 10px !important;\n  font-size: 12px !important;\n  font-family: inherit !important;\n  outline: none !important;\n  box-sizing: border-box !important;\n}\n.wl-select {\n  cursor: pointer;\n  appearance: auto !important;\n  -webkit-appearance: auto !important;\n}\n.wl-select option {\n  background-color: #1a1a1a !important;\n  color: #ffffff !important;\n  padding: 6px 10px !important;\n}\n.wl-input:focus, .wl-select:focus, .wl-textarea:focus {\n  border-color: #FF5E1F !important;\n}\n.wl-textarea {\n  width: 100% !important;\n  background-color: #141414 !important;\n  border: 1px solid #333333 !important;\n  color: #f0f0f0 !important;\n  border-radius: 2px !important;\n  padding: 8px 10px !important;\n  font-size: 12px !important;\n  font-family: inherit !important;\n  outline: none !important;\n  box-sizing: border-box !important;\n  resize: vertical !important;\n  min-height: 60px !important;\n}\n.wl-submit-btn {\n  width: 100%;\n  height: 34px;\n  background-color: #FF5E1F;\n  border: none;\n  color: #000000;\n  border-radius: 2px;\n  font-weight: 800;\n  font-size: 11px;\n  letter-spacing: 0.8px;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: opacity 0.15s;\n}\n.wl-submit-btn:hover {\n  opacity: 0.9;\n}\n.wl-notif-item {\n  background: #141414;\n  border: 1px solid #262626;\n  border-radius: 2px;\n  padding: 10px 12px;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 10px;\n}\n</style>\n\n<div class=\"wl-ctrl-root\">\n  <!-- Верхняя строка состояния -->\n  <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #222222; padding-bottom: 10px;\">\n    <div style=\"display: flex; align-items: center; gap: 10px;\">\n      <span style=\"font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: #FF5E1F;\">WARLINK CONTROL PLANE</span>\n      <span style=\"font-size: 11px; color: #555;\">//</span>\n      <span style=\"font-size: 11px; color: #888; font-weight: 600;\">ЕДИНЫЙ ПУЛЬТ ОПЕРАТИВНОГО УПРАВЛЕНИЯ</span>\n    </div>\n    <div id=\"wl-global-status\" style=\"font-size: 11px; font-weight: 700; font-family: monospace; color: #22c55e;\">ГОТОВ К РАБОТЕ</div>\n  </div>\n\n  <!-- РАЗДЕЛ 1: Системные переключатели (Zero-Restart) -->\n  <div style=\"margin-bottom: 20px;\">\n    <div style=\"font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #888; margin-bottom: 8px;\">\n      1. Системные функциональные режимы (Zero-Restart)\n    </div>\n    <div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;\">\n      <!-- Тумблер 1: СБП -->\n      <div style=\"background: #161616; border: 1px solid #282828; border-radius: 2px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: space-between;\">\n        <div style=\"font-size: 10px; text-transform: uppercase; color: #888; font-weight: 600; margin-bottom: 8px;\">Сбор пожертвований (СБП)</div>\n        <button id=\"wl-btn-donate\" onclick=\"wlToggleCtrl('enable_donate')\" style=\"width: 100%; padding: 8px; border: 1px solid #22c55e; background: #112211; color: #4ade80; border-radius: 2px; font-weight: 700; font-family: monospace; cursor: pointer; font-size: 12px; transition: all 0.15s;\">ВКЛЮЧЕНО</button>\n      </div>\n\n      <!-- Тумблер 2: Цели сообщества -->\n      <div style=\"background: #161616; border: 1px solid #282828; border-radius: 2px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: space-between;\">\n        <div style=\"font-size: 10px; text-transform: uppercase; color: #888; font-weight: 600; margin-bottom: 8px;\">Блок целей сообщества</div>\n        <button id=\"wl-btn-goal\" onclick=\"wlToggleCtrl('enable_community_goal')\" style=\"width: 100%; padding: 8px; border: 1px solid #22c55e; background: #112211; color: #4ade80; border-radius: 2px; font-weight: 700; font-family: monospace; cursor: pointer; font-size: 12px; transition: all 0.15s;\">ВКЛЮЧЕНО</button>\n      </div>\n\n      <!-- Тумблер 3: Голосование -->\n      <div style=\"background: #161616; border: 1px solid #282828; border-radius: 2px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: space-between;\">\n        <div style=\"font-size: 10px; text-transform: uppercase; color: #888; font-weight: 600; margin-bottom: 8px;\">Голосование за новые игры</div>\n        <button id=\"wl-btn-voting\" onclick=\"wlToggleCtrl('enable_voting')\" style=\"width: 100%; padding: 8px; border: 1px solid #22c55e; background: #112211; color: #4ade80; border-radius: 2px; font-weight: 700; font-family: monospace; cursor: pointer; font-size: 12px; transition: all 0.15s;\">ВКЛЮЧЕНО</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- РАЗДЕЛ: Цель сбора на Boosty (Прогресс-бар в клиенте) -->\n  <div style=\"margin-bottom: 20px;\">\n    <div style=\"background: #161616; border: 1px solid #282828; border-left: 3px solid #FF5E1F; border-radius: 2px; padding: 14px 16px;\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid #242424; padding-bottom: 8px;\">\n        <div style=\"display: flex; align-items: center; gap: 8px;\">\n          <span style=\"font-size: 11px; text-transform: uppercase; color: #FF5E1F; font-weight: 700; letter-spacing: 0.5px;\">Цель сбора на Boosty (Прогресс-бар в клиенте)</span>\n          <span style=\"font-size: 10px; color: #666; font-family: monospace;\">// WarLink | Поддержка дальнейшей разработки | Долги</span>\n        </div>\n        <div id=\"wl-boosty-summary\" style=\"font-size: 11px; font-family: monospace; color: #a3a3a3;\">\n          Загрузка цели...\n        </div>\n      </div>\n\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr 140px 180px; gap: 12px; align-items: flex-end;\">\n        <div>\n          <label class=\"wl-label\">Собрано сейчас (₽):</label>\n          <input type=\"number\" id=\"wl-boosty-current\" value=\"0\" min=\"0\" max=\"10000000\" step=\"500\" class=\"wl-input\" style=\"font-family: monospace; font-weight: 700; text-align: right;\">\n        </div>\n        <div>\n          <label class=\"wl-label\">Целевая сумма (₽):</label>\n          <input type=\"number\" id=\"wl-boosty-target\" value=\"100000\" min=\"1000\" max=\"10000000\" step=\"1000\" class=\"wl-input\" style=\"font-family: monospace; font-weight: 700; text-align: right;\">\n        </div>\n        <div>\n          <button onclick=\"wlSaveBoostyGoal()\" class=\"wl-submit-btn\" style=\"height: 34px;\">СОХРАНИТЬ</button>\n        </div>\n        <div>\n          <button onclick=\"wlSyncBoostyGoal()\" style=\"width: 100%; height: 34px; background: #1f1f1f; border: 1px solid #333; color: #e5e5e5; border-radius: 2px; font-weight: 700; font-size: 11px; letter-spacing: 0.5px; text-transform: uppercase; cursor: pointer; transition: all 0.15s;\">СПАРСИТЬ С BOOSTY</button>\n        </div>\n      </div>\n      <div id=\"wl-boosty-status\" style=\"margin-top: 8px; font-size: 10px; font-family: monospace; color: #22c55e;\"></div>\n    </div>\n  </div>\n\n  <!-- РАЗДЕЛ 2: Управление пулом игровых слотов (Zero-Restart) -->\n  <div style=\"margin-bottom: 22px;\">\n    <div style=\"background: #161616; border: 1px solid #282828; border-radius: 2px; padding: 14px 16px;\">\n      <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid #242424; padding-bottom: 8px;\">\n        <div style=\"display: flex; align-items: center; gap: 8px;\">\n          <span style=\"font-size: 11px; text-transform: uppercase; color: #FF5E1F; font-weight: 700; letter-spacing: 0.5px;\">2. Управление пулом игровых слотов</span>\n          <span style=\"font-size: 10px; color: #666; font-family: monospace;\">// Hysteria 2 QUIC Slot Allocation</span>\n        </div>\n        <div id=\"wl-slots-summary\" style=\"font-size: 11px; font-family: monospace; color: #a3a3a3;\">\n          Загрузка пула...\n        </div>\n      </div>\n\n      <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;\">\n        <!-- Слот 1: Общий пул слотов -->\n        <div style=\"background: #111111; border: 1px solid #333333; border-radius: 2px; padding: 10px 12px; display: flex; flex-direction: column; justify-content: space-between;\">\n          <div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;\">\n              <span style=\"font-size: 10px; text-transform: uppercase; color: #888; font-weight: 700;\">Общий пул слотов</span>\n              <span id=\"wl-badge-total-active\" style=\"font-size: 10px; font-family: monospace; color: #FF5E1F;\">0 онлайн</span>\n            </div>\n            <div style=\"font-size: 10px; color: #666; margin-bottom: 8px;\">Суммарная емкость шлюза</div>\n          </div>\n          <div style=\"display: flex; gap: 6px;\">\n            <input type=\"number\" id=\"wl-input-max-sess\" value=\"100\" min=\"5\" max=\"500\" class=\"wl-input\" style=\"width: 70px; text-align: right; font-family: monospace; font-weight: 700;\">\n            <button onclick=\"wlApplyField('max_sessions', 'wl-input-max-sess')\" class=\"wl-submit-btn\" style=\"flex: 1;\">OK</button>\n          </div>\n        </div>\n\n        <!-- Слот 2: Резерв спонсоров -->\n        <div style=\"background: #111111; border: 1px solid #333333; border-radius: 2px; padding: 10px 12px; display: flex; flex-direction: column; justify-content: space-between;\">\n          <div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;\">\n              <span style=\"font-size: 10px; text-transform: uppercase; color: #888; font-weight: 700;\">Резерв спонсоров</span>\n              <span id=\"wl-badge-sponsor-active\" style=\"font-size: 10px; font-family: monospace; color: #4ade80;\">0 онлайн</span>\n            </div>\n            <div style=\"font-size: 10px; color: #666; margin-bottom: 8px;\">Гарантия без вытеснения</div>\n          </div>\n          <div style=\"display: flex; gap: 6px;\">\n            <input type=\"number\" id=\"wl-input-sponsor-slots\" value=\"10\" min=\"0\" max=\"500\" class=\"wl-input\" style=\"width: 70px; text-align: right; font-family: monospace; font-weight: 700;\">\n            <button onclick=\"wlApplyField('dedicated_sponsor_slots', 'wl-input-sponsor-slots')\" class=\"wl-submit-btn\" style=\"flex: 1;\">OK</button>\n          </div>\n        </div>\n\n        <!-- Слот 3: Лимит бесплатных слотов -->\n        <div style=\"background: #111111; border: 1px solid #333333; border-radius: 2px; padding: 10px 12px; display: flex; flex-direction: column; justify-content: space-between;\">\n          <div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;\">\n              <span style=\"font-size: 10px; text-transform: uppercase; color: #888; font-weight: 700;\">Бесплатный пул</span>\n              <span id=\"wl-badge-free-active\" style=\"font-size: 10px; font-family: monospace; color: #38bdf8;\">0 онлайн</span>\n            </div>\n            <div style=\"font-size: 10px; color: #666; margin-bottom: 8px;\">Лимит обычных игроков</div>\n          </div>\n          <div style=\"display: flex; gap: 6px;\">\n            <input type=\"number\" id=\"wl-input-free-slots\" value=\"89\" min=\"1\" max=\"500\" class=\"wl-input\" style=\"width: 70px; text-align: right; font-family: monospace; font-weight: 700;\">\n            <button onclick=\"wlApplyField('free_slots_limit', 'wl-input-free-slots')\" class=\"wl-submit-btn\" style=\"flex: 1;\">OK</button>\n          </div>\n        </div>\n\n        <!-- Слот 4: Служебный слот админа -->\n        <div style=\"background: #111111; border: 1px solid #222222; border-radius: 2px; padding: 10px 12px; display: flex; flex-direction: column; justify-content: space-between;\">\n          <div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;\">\n              <span style=\"font-size: 10px; text-transform: uppercase; color: #888; font-weight: 700;\">Резерв ядра</span>\n              <span style=\"font-size: 10px; font-family: monospace; color: #f59e0b;\">1 слот</span>\n            </div>\n            <div style=\"font-size: 10px; color: #666;\">Фиксированный вход ядра</div>\n          </div>\n          <div style=\"font-size: 11px; font-family: monospace; color: #888; background: #161616; padding: 8px 8px; border-radius: 2px; border: 1px solid #262626; text-align: center; font-weight: 600;\">\n            АДМИНИСТРАТОР (1)\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- РАЗДЕЛ 3: Диспетчер внутриигровых уведомлений -->\n  <div>\n    <div style=\"font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #888; margin-bottom: 8px;\">\n      3. Диспетчер внутриигровых уведомлений (In-App Dispatcher)\n    </div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 16px;\">\n      <!-- Левая колонка: Форма создания -->\n      <div style=\"background: #161616; border: 1px solid #282828; border-radius: 2px; padding: 16px;\">\n        <div style=\"font-size: 11px; text-transform: uppercase; color: #FF5E1F; font-weight: 700; margin-bottom: 12px;\">Новое уведомление в клиенты</div>\n        \n        <div style=\"margin-bottom: 10px;\">\n          <label class=\"wl-label\">Заголовок:</label>\n          <input type=\"text\" id=\"wl-notif-title\" class=\"wl-input\" placeholder=\"Напр. Плановые технические работы\">\n        </div>\n\n        <div style=\"margin-bottom: 10px;\">\n          <label class=\"wl-label\">Текст сообщения:</label>\n          <textarea id=\"wl-notif-msg\" class=\"wl-textarea\" rows=\"3\" placeholder=\"Подробный текст оповещения для игроков...\"></textarea>\n        </div>\n\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;\">\n          <div>\n            <label class=\"wl-label\">Получатель:</label>\n            <select id=\"wl-notif-target\" class=\"wl-select\" onchange=\"wlOnTargetChange()\">\n              <option value=\"broadcast\">Всем игрокам (Broadcast)</option>\n              <option value=\"account\">По номеру аккаунта</option>\n              <option value=\"device\">По Device ID</option>\n            </select>\n          </div>\n          <div>\n            <label class=\"wl-label\">Уровень важности:</label>\n            <select id=\"wl-notif-sev\" class=\"wl-select\">\n              <option value=\"info\">Инфо (Нейтральное)</option>\n              <option value=\"update\">Обновление (Зеленый)</option>\n              <option value=\"warning\">Предупреждение (Оранжевый)</option>\n              <option value=\"urgent\">Срочное (Красный)</option>\n            </select>\n          </div>\n        </div>\n\n        <div id=\"wl-notif-target-id-row\" style=\"display: none; margin-bottom: 10px;\">\n          <label class=\"wl-label\">Номер аккаунта / Device ID:</label>\n          <input type=\"text\" id=\"wl-notif-target-id\" class=\"wl-input\" placeholder=\"XXXX-XXXX-XXXX-XXXX\" style=\"font-family: monospace;\">\n        </div>\n\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px;\">\n          <div>\n            <label class=\"wl-label\">Кнопка действия (опция):</label>\n            <input type=\"text\" id=\"wl-notif-act-label\" class=\"wl-input\" placeholder=\"Напр. Подробнее\">\n          </div>\n          <div>\n            <label class=\"wl-label\">Ссылка действия (URL):</label>\n            <input type=\"text\" id=\"wl-notif-act-url\" class=\"wl-input\" placeholder=\"https://...\">\n          </div>\n        </div>\n\n        <button onclick=\"wlSendNotification()\" class=\"wl-submit-btn\">ОТПРАВИТЬ УВЕДОМЛЕНИЕ В КЛИЕНТЫ</button>\n      </div>\n\n      <!-- Правая колонка: Журнал активных уведомлений -->\n      <div style=\"background: #161616; border: 1px solid #282828; border-radius: 2px; padding: 16px; display: flex; flex-direction: column;\">\n        <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;\">\n          <span style=\"font-size: 11px; text-transform: uppercase; color: #a3a3a3; font-weight: 700;\">Активные уведомления в сети</span>\n          <button onclick=\"wlFetchNotifications()\" style=\"background: none; border: 1px solid #333; color: #888; padding: 3px 10px; border-radius: 2px; font-size: 10px; cursor: pointer;\">Обновить</button>\n        </div>\n        <div id=\"wl-notif-list\" style=\"flex: 1; overflow-y: auto; max-height: 310px; display: flex; flex-direction: column; gap: 8px;\">\n          <div style=\"color: #666; font-size: 11px; text-align: center; padding: 35px;\">Загрузка уведомлений...</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nconst wlApiProxy = '/api/datasources/proxy/uid/warlink-infinity';\nlet wlCtrlData = {\n  enable_donate: true,\n  enable_voting: true,\n  enable_community_goal: true,\n  max_sessions: 100,\n  dedicated_sponsor_slots: 10,\n  free_slots_limit: 89,\n  active_sessions: 0,\n  active_sponsor_sessions: 0,\n  active_free_sessions: 0\n};\n\nfunction escapeHtml(str) {\n  if (!str) return '';\n  return String(str)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#039;');\n}\n\nasync function wlFetchCtrl() {\n  try {\n    const r = await fetch(wlApiProxy + '/api/v1/admin/settings');\n    if (r.ok) {\n      wlCtrlData = await r.json();\n      wlRenderCtrl();\n    }\n  } catch(e) {}\n}\n\nfunction wlRenderCtrl() {\n  const dBtn = document.getElementById('wl-btn-donate');\n  const vBtn = document.getElementById('wl-btn-voting');\n  const gBtn = document.getElementById('wl-btn-goal');\n  const mSess = document.getElementById('wl-input-max-sess');\n  const sSponsor = document.getElementById('wl-input-sponsor-slots');\n  const fSlots = document.getElementById('wl-input-free-slots');\n\n  if (dBtn) {\n    dBtn.textContent = wlCtrlData.enable_donate ? 'ВКЛЮЧЕНО' : 'ОТКЛЮЧЕНО';\n    dBtn.style.background = wlCtrlData.enable_donate ? '#112211' : '#221111';\n    dBtn.style.borderColor = wlCtrlData.enable_donate ? '#22c55e' : '#ef4444';\n    dBtn.style.color = wlCtrlData.enable_donate ? '#4ade80' : '#f87171';\n  }\n  if (vBtn) {\n    vBtn.textContent = wlCtrlData.enable_voting ? 'ВКЛЮЧЕНО' : 'ОТКЛЮЧЕНО';\n    vBtn.style.background = wlCtrlData.enable_voting ? '#112211' : '#221111';\n    vBtn.style.borderColor = wlCtrlData.enable_voting ? '#22c55e' : '#ef4444';\n    vBtn.style.color = wlCtrlData.enable_voting ? '#4ade80' : '#f87171';\n  }\n  if (gBtn) {\n    const isGEn = (wlCtrlData.enable_community_goal !== false);\n    gBtn.textContent = isGEn ? 'ВКЛЮЧЕНО' : 'ОТКЛЮЧЕНО';\n    gBtn.style.background = isGEn ? '#112211' : '#221111';\n    gBtn.style.borderColor = isGEn ? '#22c55e' : '#ef4444';\n    gBtn.style.color = isGEn ? '#4ade80' : '#f87171';\n  }\n\n  if (mSess && wlCtrlData.max_sessions) mSess.value = wlCtrlData.max_sessions;\n  if (sSponsor && wlCtrlData.dedicated_sponsor_slots !== undefined) sSponsor.value = wlCtrlData.dedicated_sponsor_slots;\n  if (fSlots && wlCtrlData.free_slots_limit !== undefined) fSlots.value = wlCtrlData.free_slots_limit;\n\n  const total = wlCtrlData.max_sessions || 100;\n  const sponsor = wlCtrlData.dedicated_sponsor_slots || 10;\n  const freeLimit = wlCtrlData.free_slots_limit || (total - sponsor - 1);\n  const activeTotal = wlCtrlData.active_sessions || 0;\n  const activeSponsor = wlCtrlData.active_sponsor_sessions || 0;\n  const activeFree = wlCtrlData.active_free_sessions || 0;\n\n  const badgeTotal = document.getElementById('wl-badge-total-active');\n  if (badgeTotal) badgeTotal.textContent = activeTotal + ' / ' + total + ' онлайн';\n\n  const badgeSponsor = document.getElementById('wl-badge-sponsor-active');\n  if (badgeSponsor) badgeSponsor.textContent = activeSponsor + ' / ' + sponsor + ' онлайн';\n\n  const badgeFree = document.getElementById('wl-badge-free-active');\n  if (badgeFree) badgeFree.textContent = activeFree + ' / ' + freeLimit + ' онлайн';\n\n  const summary = document.getElementById('wl-slots-summary');\n  if (summary) {\n    const available = Math.max(0, total - activeTotal - 1);\n    summary.innerHTML = `Занято: <strong style=\"color:#ffffff;\">${activeTotal}</strong>/${total} | Свободно для входа: <strong style=\"color:#4ade80;\">${available}</strong> слотов`;\n  }\n}\n\nasync function wlToggleCtrl(name) {\n  const payload = {};\n  payload[name] = !wlCtrlData[name];\n  await wlSendUpdate(payload);\n}\n\nasync function wlApplyField(name, inputId) {\n  const el = document.getElementById(inputId);\n  if (!el) return;\n  const val = parseInt(el.value, 10);\n  if (isNaN(val) || val < 0) return;\n  const payload = {};\n  payload[name] = val;\n  await wlSendUpdate(payload);\n}\n\nasync function wlSendUpdate(payload) {\n  const statusEl = document.getElementById('wl-global-status');\n  if (statusEl) {\n    statusEl.textContent = 'СОХРАНЕНИЕ...';\n    statusEl.style.color = '#FF5E1F';\n  }\n  try {\n    const r = await fetch(wlApiProxy + '/api/v1/admin/settings', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(payload)\n    });\n    if (r.ok) {\n      wlCtrlData = await r.json();\n      wlRenderCtrl();\n      if (statusEl) {\n        statusEl.textContent = 'ИЗМЕНЕНИЯ СОХРАНЕНЫ';\n        statusEl.style.color = '#22c55e';\n        setTimeout(() => { if (statusEl) statusEl.textContent = 'ГОТОВ К РАБОТЕ'; }, 3000);\n      }\n    }\n  } catch(e) {\n    if (statusEl) {\n      statusEl.textContent = 'ОШИБКА СОХРАНЕНИЯ';\n      statusEl.style.color = '#ef4444';\n    }\n  }\n}\n\nfunction wlOnTargetChange() {\n  const target = document.getElementById('wl-notif-target').value;\n  const row = document.getElementById('wl-notif-target-id-row');\n  if (row) row.style.display = (target === 'broadcast') ? 'none' : 'block';\n}\n\nasync function wlFetchNotifications() {\n  const listEl = document.getElementById('wl-notif-list');\n  if (!listEl) return;\n  try {\n    const r = await fetch(wlApiProxy + '/api/v1/admin/notifications');\n    if (r.ok) {\n      const d = await r.json();\n      const items = d.notifications || [];\n      if (items.length === 0) {\n        listEl.innerHTML = '<div style=\"color: #666; font-size: 11px; text-align: center; padding: 40px 10px;\">Нет активных уведомлений в сети</div>';\n        return;\n      }\n      listEl.innerHTML = items.map(n => {\n        let badgeColor = '#3b82f6';\n        let badgeBg = 'rgba(59, 130, 246, 0.15)';\n        if (n.severity === 'update') { badgeColor = '#22c55e'; badgeBg = 'rgba(34, 197, 94, 0.15)'; }\n        if (n.severity === 'warning') { badgeColor = '#f59e0b'; badgeBg = 'rgba(245, 158, 11, 0.15)'; }\n        if (n.severity === 'urgent') { badgeColor = '#ef4444'; badgeBg = 'rgba(239, 68, 68, 0.15)'; }\n        const targetStr = (n.target_type === 'broadcast') ? 'ВСЕМ' : (escapeHtml(n.target_type) + ': ' + escapeHtml(n.target_id || '-'));\n        const dt = new Date(n.created_at);\n        const timeStr = !isNaN(dt.getTime()) ? (String(dt.getDate()).padStart(2, '0') + '.' + String(dt.getMonth() + 1).padStart(2, '0') + ' ' + String(dt.getHours()).padStart(2, '0') + ':' + String(dt.getMinutes()).padStart(2, '0')) : escapeHtml(n.created_at || '');\n        return `\n          <div class=\"wl-notif-item\">\n            <div style=\"flex: 1; min-width: 0;\">\n              <div style=\"display: flex; align-items: center; gap: 6px; margin-bottom: 4px;\">\n                <span style=\"font-size: 9px; font-weight: 800; text-transform: uppercase; color: ${badgeColor}; background: ${badgeBg}; padding: 2px 6px; border-radius: 2px; border: 1px solid ${badgeColor}50;\">${escapeHtml(n.severity)}</span>\n                <span style=\"font-size: 10px; color: #888; font-family: monospace;\">${targetStr}</span>\n                <span style=\"font-size: 10px; color: #666; margin-left: auto; font-family: monospace;\" title=\"${escapeHtml(n.created_at || '')}\">${timeStr}</span>\n              </div>\n              <div style=\"font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 3px; word-break: break-word;\">${escapeHtml(n.title)}</div>\n              <div style=\"font-size: 11px; color: #a3a3a3; line-height: 1.4; word-break: break-word;\">${escapeHtml(n.message)}</div>\n              ${n.action_label ? `<div style=\"margin-top: 6px; font-size: 10px; color: #FF5E1F; font-weight: 600;\">Кнопка: [${escapeHtml(n.action_label)}] &rarr; ${escapeHtml(n.action_url || '')}</div>` : ''}\n            </div>\n            <button onclick=\"wlDeleteNotification(${n.id})\" style=\"background: #2a1111; border: 1px solid #ef444440; color: #f87171; padding: 4px 8px; border-radius: 2px; font-size: 10px; cursor: pointer; font-weight: 700; flex-shrink: 0;\" title=\"Удалить уведомление\">&#x2715;</button>\n          </div>\n        `;\n      }).join('');\n    } else {\n      listEl.innerHTML = '<div style=\"color: #ef4444; font-size: 11px; text-align: center; padding: 40px 10px;\">Ошибка загрузки списка (код ' + r.status + ')</div>';\n    }\n  } catch(e) {\n    listEl.innerHTML = '<div style=\"color: #ef4444; font-size: 11px; text-align: center; padding: 40px 10px;\">Сетевая ошибка при загрузке</div>';\n  }\n}\n\nasync function wlSendNotification() {\n  const statusEl = document.getElementById('wl-global-status');\n  const title = (document.getElementById('wl-notif-title').value || '').trim();\n  const message = (document.getElementById('wl-notif-msg').value || '').trim();\n  const targetType = document.getElementById('wl-notif-target').value;\n  const targetId = (document.getElementById('wl-notif-target-id').value || '').trim();\n  const severity = document.getElementById('wl-notif-sev').value;\n  const actionLabel = (document.getElementById('wl-notif-act-label').value || '').trim();\n  const actionUrl = (document.getElementById('wl-notif-act-url').value || '').trim();\n\n  if (!title || !message) {\n    if (statusEl) {\n      statusEl.textContent = 'ОШИБКА: ЗАПОЛНИТЕ ЗАГОЛОВОК И ТЕКСТ';\n      statusEl.style.color = '#ef4444';\n    }\n    return;\n  }\n\n  if (statusEl) {\n    statusEl.textContent = 'ОТПРАВКА УВЕДОМЛЕНИЯ...';\n    statusEl.style.color = '#FF5E1F';\n  }\n\n  try {\n    const r = await fetch(wlApiProxy + '/api/v1/admin/notifications', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        title,\n        message,\n        target_type: targetType,\n        target_id: targetId,\n        severity,\n        action_label: actionLabel,\n        action_url: actionUrl\n      })\n    });\n    if (r.ok) {\n      if (statusEl) {\n        statusEl.textContent = 'УВЕДОМЛЕНИЕ УСПЕШНО РАЗОСЛАНО В WARLINK';\n        statusEl.style.color = '#22c55e';\n        setTimeout(() => { if (statusEl) statusEl.textContent = 'ГОТОВ К РАБОТЕ'; }, 4000);\n      }\n      document.getElementById('wl-notif-title').value = '';\n      document.getElementById('wl-notif-msg').value = '';\n      document.getElementById('wl-notif-act-label').value = '';\n      document.getElementById('wl-notif-act-url').value = '';\n      wlFetchNotifications();\n    } else {\n      const err = await r.json();\n      if (statusEl) {\n        statusEl.textContent = 'ОШИБКА: ' + (err.error || 'не удалось отправить');\n        statusEl.style.color = '#ef4444';\n      }\n    }\n  } catch(e) {\n    if (statusEl) {\n      statusEl.textContent = 'СЕТЕВАЯ ОШИБКА ПРИ ОТПРАВКЕ';\n      statusEl.style.color = '#ef4444';\n    }\n  }\n}\n\nasync function wlDeleteNotification(id) {\n  if (!confirm('Удалить уведомление #' + id + '?')) return;\n  try {\n    const r = await fetch(wlApiProxy + '/api/v1/admin/notifications?id=' + id, { method: 'DELETE' });\n    if (r.ok) {\n      wlFetchNotifications();\n    }\n  } catch(e) {}\n}\n\n\nasync function wlFetchBoosty() {\n  try {\n    const r = await fetch(wlApiProxy + '/api/v1/boosty-goal');\n    if (r.ok) {\n      const d = await r.json();\n      if (d && d.success) {\n        const cIn = document.getElementById('wl-boosty-current');\n        const tIn = document.getElementById('wl-boosty-target');\n        const sumEl = document.getElementById('wl-boosty-summary');\n        if (cIn) cIn.value = d.current_amount || 0;\n        if (tIn) tIn.value = d.target_amount || 100000;\n        if (sumEl) {\n          const src = d.source === 'auto_parser' ? 'авто-парсер' : 'ручной ввод';\n          sumEl.innerHTML = `Собрано: <strong style=\"color:#ffffff;\">${(d.current_amount || 0).toLocaleString('ru-RU')} ₽</strong> из ${(d.target_amount || 100000).toLocaleString('ru-RU')} ₽ (<span style=\"color:#FF5E1F;\">${d.percent || 0}%</span>, ${src})`;\n        }\n      }\n    }\n  } catch(e) {}\n}\n\nasync function wlSaveBoostyGoal() {\n  const statusEl = document.getElementById('wl-boosty-status');\n  const curr = parseInt(document.getElementById('wl-boosty-current').value, 10) || 0;\n  const tgt = parseInt(document.getElementById('wl-boosty-target').value, 10) || 100000;\n  if (statusEl) { statusEl.textContent = 'СОХРАНЕНИЕ...'; statusEl.style.color = '#FF5E1F'; }\n  try {\n    const r = await fetch(wlApiProxy + '/api/v1/admin/boosty-goal', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ current_amount: curr, target_amount: tgt })\n    });\n    if (r.ok) {\n      if (statusEl) {\n        statusEl.textContent = 'ЦЕЛЬ BOOSTY УСПЕШНО СОХРАНЕНА';\n        statusEl.style.color = '#22c55e';\n        setTimeout(() => { if (statusEl) statusEl.textContent = ''; }, 3000);\n      }\n      wlFetchBoosty();\n    } else {\n      if (statusEl) { statusEl.textContent = 'ОШИБКА СОХРАНЕНИЯ'; statusEl.style.color = '#ef4444'; }\n    }\n  } catch(e) {\n    if (statusEl) { statusEl.textContent = 'СЕТЕВАЯ ОШИБКА'; statusEl.style.color = '#ef4444'; }\n  }\n}\n\nasync function wlSyncBoostyGoal() {\n  const statusEl = document.getElementById('wl-boosty-status');\n  if (statusEl) { statusEl.textContent = 'СИНХРОНИЗАЦИЯ С BOOSTY...'; statusEl.style.color = '#FF5E1F'; }\n  try {\n    const r = await fetch(wlApiProxy + '/api/v1/admin/boosty-goal/parse', { method: 'POST' });\n    const d = await r.json();\n    if (statusEl) {\n      statusEl.textContent = d.message || (d.success ? 'УСПЕШНО СПАРСЕНО С BOOSTY' : 'НЕ УДАЛОСЬ СПАРСИТЬ');\n      statusEl.style.color = d.success ? '#22c55e' : '#f59e0b';\n      setTimeout(() => { if (statusEl) statusEl.textContent = ''; }, 4000);\n    }\n    wlFetchBoosty();\n  } catch(e) {\n    if (statusEl) { statusEl.textContent = 'СЕТЕВАЯ ОШИБКА'; statusEl.style.color = '#ef4444'; }\n  }\n}\n\nwlFetchCtrl();\nwlFetchNotifications();\nwlFetchBoosty();\nsetInterval(() => {\n  wlFetchCtrl();\n  wlFetchNotifications();\n  wlFetchBoosty();\n}, 10000);\n</script>",
        "mode": "html"
      },
