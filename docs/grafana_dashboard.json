      "id": 102,
      "title": "ИНТЕРАКТИВНОЕ АДМИНИСТРИРОВАНИЕ ШЛЮЗА (WARLINK CONTROL PLANE)",
      "type": "row"
    },
    {
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "id": 9,
      "options": {
        "content": "<div style=\"background: #111111; border: 1px solid #242424; border-radius: 4px; padding: 20px; font-family: -apple-system, sans-serif;\">\n  <div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #242424; padding-bottom: 12px; margin-bottom: 16px;\">\n    <div>\n      <span style=\"font-size: 15px; font-weight: 700; color: #fff; letter-spacing: 0.5px;\">УПРАВЛЕНИЕ ПАРАМЕТРАМИ ШЛЮЗА</span>\n      <div style=\"font-size: 11px; color: #888; font-family: monospace; margin-top: 2px;\">Изменения применяются на сервере в реальном времени без перезагрузки</div>\n    </div>\n    <div id=\"ctrl-status-msg\" style=\"font-size: 12px; font-weight: 600; color: #22c55e;\"></div>\n  </div>\n\n  <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 20px;\">\n    <div style=\"background: #161616; border: 1px solid #2a2a2a; border-radius: 4px; padding: 14px;\">\n      <label style=\"display: block; font-size: 11px; color: #aaa; text-transform: uppercase; margin-bottom: 8px; font-weight: 600;\">Приём донатов через СБП</label>\n      <button id=\"btn-toggle-donate\" onclick=\"toggleCtrl('enable_donate')\" style=\"background: #22c55e; border: none; color: #000; padding: 6px 14px; border-radius: 2px; font-weight: 700; cursor: pointer; font-size: 12px;\">ВКЛЮЧЕНО</button>\n    </div>\n\n    <div style=\"background: #161616; border: 1px solid #2a2a2a; border-radius: 4px; padding: 14px;\">\n      <label style=\"display: block; font-size: 11px; color: #aaa; text-transform: uppercase; margin-bottom: 8px; font-weight: 600;\">Голосование за игры сообщества</label>\n      <button id=\"btn-toggle-voting\" onclick=\"toggleCtrl('enable_voting')\" style=\"background: #22c55e; border: none; color: #000; padding: 6px 14px; border-radius: 2px; font-weight: 700; cursor: pointer; font-size: 12px;\">ВКЛЮЧЕНО</button>\n    </div>\n\n    <div style=\"background: #161616; border: 1px solid #2a2a2a; border-radius: 4px; padding: 14px;\">\n      <label style=\"display: block; font-size: 11px; color: #aaa; text-transform: uppercase; margin-bottom: 8px; font-weight: 600;\">Сумма доната (руб.)</label>\n      <div style=\"display: flex; gap: 8px;\">\n        <input type=\"number\" id=\"input-donate-amt\" value=\"98\" style=\"background: #0d0d0d; border: 1px solid #333; color: #fff; padding: 6px 10px; border-radius: 2px; width: 100px; font-weight: 600; font-family: monospace;\">\n        <button onclick=\"applyField('donate_amount_rub')\" style=\"background: #FF5E1F; border: none; color: #000; padding: 6px 12px; border-radius: 2px; font-weight: 700; cursor: pointer; font-size: 11px;\">Сохранить</button>\n      </div>\n    </div>\n\n    <div style=\"background: #161616; border: 1px solid #2a2a2a; border-radius: 4px; padding: 14px;\">\n      <label style=\"display: block; font-size: 11px; color: #aaa; text-transform: uppercase; margin-bottom: 8px; font-weight: 600;\">Лимит сессий (слотов)</label>\n      <div style=\"display: flex; gap: 8px;\">\n        <input type=\"number\" id=\"input-max-sess\" value=\"100\" style=\"background: #0d0d0d; border: 1px solid #333; color: #fff; padding: 6px 10px; border-radius: 2px; width: 100px; font-weight: 600; font-family: monospace;\">\n        <button onclick=\"applyField('max_sessions')\" style=\"background: #FF5E1F; border: none; color: #000; padding: 6px 12px; border-radius: 2px; font-weight: 700; cursor: pointer; font-size: 11px;\">Сохранить</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nlet ctrlState = { enable_donate: true, enable_voting: true, donate_amount_rub: 98, max_sessions: 100 };\n\nasync function loadCtrlState() {\n  try {\n    const r = await fetch('http://138.124.103.99/api/v1/admin/settings?key=wl_sec_dash_784bc862c5e8b9b1ea31bf5c');\n    if (r.ok) {\n      const d = await r.json();\n      ctrlState = d;\n      updateCtrlUI();\n    }\n  } catch (e) {\n    console.error('Error fetching admin settings:', e);\n  }\n}\n\nfunction updateCtrlUI() {\n  const dBtn = document.getElementById('btn-toggle-donate');\n  const vBtn = document.getElementById('btn-toggle-voting');\n  const dAmt = document.getElementById('input-donate-amt');\n  const mSess = document.getElementById('input-max-sess');\n  if (dBtn) {\n    dBtn.textContent = ctrlState.enable_donate ? 'ВКЛЮЧЕНО' : 'ОТКЛЮЧЕНО';\n    dBtn.style.background = ctrlState.enable_donate ? '#22c55e' : '#ef4444';\n  }\n  if (vBtn) {\n    vBtn.textContent = ctrlState.enable_voting ? 'ВКЛЮЧЕНО' : 'ОТКЛЮЧЕНО';\n    vBtn.style.background = ctrlState.enable_voting ? '#22c55e' : '#ef4444';\n  }\n  if (dAmt && ctrlState.donate_amount_rub) dAmt.value = ctrlState.donate_amount_rub;\n  if (mSess && ctrlState.max_sessions) mSess.value = ctrlState.max_sessions;\n}\n\nasync function toggleCtrl(name) {\n  const newVal = !ctrlState[name];\n  const payload = {};\n  payload[name] = newVal;\n  await sendCtrlUpdate(payload);\n}\n\nasync function applyField(name) {\n  const payload = {};\n  if (name === 'donate_amount_rub') {\n    payload[name] = parseInt(document.getElementById('input-donate-amt').value, 10);\n  } else if (name === 'max_sessions') {\n    payload[name] = parseInt(document.getElementById('input-max-sess').value, 10);\n  }\n  await sendCtrlUpdate(payload);\n}\n\nasync function sendCtrlUpdate(payload) {\n  const statusMsg = document.getElementById('ctrl-status-msg');\n  try {\n    const r = await fetch('http://138.124.103.99/api/v1/admin/settings?key=wl_sec_dash_784bc862c5e8b9b1ea31bf5c', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(payload)\n    });\n    if (r.ok) {\n      ctrlState = await r.json();\n      updateCtrlUI();\n      if (statusMsg) {\n        statusMsg.textContent = 'Настройки успешно применены!';\n        setTimeout(() => { statusMsg.textContent = ''; }, 3000);\n      }\n    }\n  } catch (e) {\n    if (statusMsg) {\n      statusMsg.textContent = 'Ошибка сохранения!';\n      statusMsg.style.color = '#ef4444';\n    }\n  }\n}\n\nloadCtrlState();\n</script>",
        "mode": "html"
      },
      "pluginVersion": "13.2.2",
      "title": "Интерактивная панель управления (WarLink Control Plane)",
      "type": "text"
    }
  ],
